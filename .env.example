# Preferred long-term: cuttle auth login <provider> (stores keys in
# ~/.config/cuttle/auth.json). Env vars below still work as overrides.

# Frontier "brain" (planning only)
CUTTLE_BRAIN_MODEL=anthropic:claude-opus-4-6
# Capability-gated — only applied if the model/provider profile supports them;
# unsupported values must fail closed at config resolve (no silent ignore).
# CUTTLE_BRAIN_CONTEXT=200000
# CUTTLE_BRAIN_THINKING=true
# CUTTLE_BRAIN_THINKING_BUDGET=10000
# CUTTLE_BRAIN_EFFORT=high

# Optional provider API keys (prefer auth store when available)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Local "hands" (execution default)
CUTTLE_HANDS_MODEL=ollama:qwen2.5-coder:32b
CUTTLE_HANDS_BASE_URL=http://127.0.0.1:11434

# Escalation hands (failed steps only)
CUTTLE_ESCALATE_HANDS_MODEL=anthropic:claude-haiku-4-5
# CUTTLE_ESCALATE_EFFORT=medium

# Budgets
CUTTLE_MAX_HANDS_RETRIES=2
CUTTLE_MAX_LOCAL_WRITERS=1
CUTTLE_MAX_SCOUTS=2
