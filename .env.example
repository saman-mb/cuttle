# Preferred long-term: cuttle auth login <provider>
# (stores keys in ~/.config/cuttle/auth.json). Env vars override.

# Optional provider API keys
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# JEV_API_KEY=

# Pool — up to five coding models (role names preferred once the gateway lands)
# CUTTLE_POOL=anthropic:claude-sonnet-4-6,openai:gpt-4.1-mini,ollama:qwen2.5-coder:32b
# CUTTLE_PRESET=balanced   # thrifty | balanced | best_quality | local_only

# Decision layer (outside the five)
# CUTTLE_DECIDE_BACKEND=jev          # jev | winnow | structured_fallback
# CUTTLE_DECIDE_MODEL=ollama:winnow-12b

# Local OpenAI-compatible endpoint (llama.cpp / Ollama / LM Studio / MLX server)
# CUTTLE_LOCAL_BASE_URL=http://127.0.0.1:11434

# Budgets
# CUTTLE_MAX_STEP_RETRIES=2
# CUTTLE_MAX_PARALLEL_LOCAL=1
# CUTTLE_SESSION_BUDGET_USD=2.00
